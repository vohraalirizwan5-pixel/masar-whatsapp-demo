# Copy to .env.local for local runs. On Vercel, set these in Project Settings -> Environment Variables.

# A workspace-scoped key from console.anthropic.com (an org-level key is refused).
# Give its workspace a monthly spend limit: this demo is public unless DEMO_PASSCODE is set.
ANTHROPIC_API_KEY=

# Optional. When set, visitors must type this before chatting. Share it with the client in the meeting.
DEMO_PASSCODE=
